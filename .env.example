# Supabase — פרויקט bait ב-https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# אופציונלי — להרצת schema אוטומטית: ./scripts/run-schema.sh
# SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# SUPABASE_DB_PASSWORD=your-db-password

# שם האפליקציה
NEXT_PUBLIC_APP_NAME=Bait

# כתובת האפליקציה (לפרסום ב-Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# סיסמה לחתימת sessions (צור עם: openssl rand -hex 32)
SESSION_SECRET=change-me-to-random-string

# עמוד /tasks — התחברות עם Google (Calendar + Contacts)
# 1. ב-Google Cloud Console: OAuth 2.0 Client ID מסוג "Web application"
# 2. את אותם Client ID/Secret מגדירים גם ב-Supabase Dashboard
#    (Authentication → Providers → Google) וגם כאן
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# עמוד /infrastructure — רשימת מיילים (מופרדים בפסיק) שרשאים לגשת
# אל דשבורד ניהול התשתיות. חייב להיות אותו מייל שמתחברים איתו ל-Google.
ADMIN_EMAILS=you@example.com
